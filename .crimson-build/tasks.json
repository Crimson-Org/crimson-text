// crimson-build writes each task as a .sh script for Linux and macOS and a .cmd script for
// Windows in this folder, and those scripts run anywhere without Crimson Build.
{
	"systems": ["unix"],
	"env": {
		"PROGRAM": "crimson-text",
		"APPLICATION_ID": "io.github.CrimsonOrg.CrimsonText",
		"VERSION": "0.1.0",
		"PREFIX": "${HOME}/.local",
		"STD": "c11",
		"WARN": "-Wall -Wextra -Wpedantic -Werror -Wno-unused-parameter",
		"OPT": "-O2 -g",
		"GTK_MINOR": "16",
		"ADWAITA_MINOR": "7",
		"SOURCE_VIEW_MINOR": "12",
		"PKGS": "gtk4 >= 4.${GTK_MINOR} libadwaita-1 >= 1.${ADWAITA_MINOR} gtksourceview-5 >= 5.${SOURCE_VIEW_MINOR} libcurl glycin-2",
		"LIBS": "-lm",
		"DEFINES": "-DAPPLICATION_VERSION=\"${VERSION}\" -DGDK_VERSION_MIN_REQUIRED=GDK_VERSION_4_${GTK_MINOR} -DGDK_VERSION_MAX_ALLOWED=GDK_VERSION_4_${GTK_MINOR} -DADW_VERSION_MIN_REQUIRED=ADW_VERSION_1_${ADWAITA_MINOR} -DADW_VERSION_MAX_ALLOWED=ADW_VERSION_1_${ADWAITA_MINOR} -DGTK_SOURCE_VERSION_MIN_REQUIRED=GTK_SOURCE_VERSION_5_${SOURCE_VIEW_MINOR} -DGTK_SOURCE_VERSION_MAX_ALLOWED=GTK_SOURCE_VERSION_5_${SOURCE_VIEW_MINOR}",
		"INCLUDES": "-Isrc -Isubprojects/crimson-core/src",
		"HEADERS": "src/*/*.h subprojects/crimson-core/src/*/*.h subprojects/crimson-core/src/*/*/*.h",
		"EXTRA_LICENSES": "md4c=src/md4c/LICENSE"
	},
	"tasks": {
		"build": {
			"description": "Build Crimson Text into the project folder",
			"steps": [
				{"needs": ["cc", "pkg-config", "glib-compile-resources"]},
				{"pkg": "${PKGS}"},
				{"mkdir": ["build/obj"]},
				"glib-compile-resources --sourcedir assets --target build/resources.c --generate-source assets/crimson-text.gresource.xml",
				"glib-compile-resources --sourcedir subprojects/crimson-core/assets --target build/core-resources.c --generate-source subprojects/crimson-core/assets/crimson-core.gresource.xml",
				{"each": {"from": "src/*.c src/app/*.c src/document/*.c src/editor/*.c src/view/*.c src/window/*.c subprojects/crimson-core/src/common/*/*.c subprojects/crimson-core/src/source/*.c", "to": "build/obj/{id}.o", "run": "cc -std=${STD} $WARN $OPT $DEFINES $INCLUDES $(pkg-config --cflags \"$PKGS\" | sed \"s/-I/-isystem /g\") -c {from} -o {to}", "also": "${HEADERS}"}},
				{"each": {"from": "src/md4c/*.c", "to": "build/obj/{id}.o", "run": "cc -std=gnu11 $OPT -w -c {from} -o {to}", "also": "src/md4c/*.h"}},
				{"each": {"from": "build/resources.c build/core-resources.c", "to": "build/obj/{id}.o", "run": "cc -std=gnu11 $OPT $(pkg-config --cflags gio-2.0) -c {from} -o {to}"}},
				"cc -o build/${PROGRAM} build/obj/*.o $(pkg-config --libs \"$PKGS\") $LIBS",
				{"copy": {"from": "build/${PROGRAM}", "to": ".${PROGRAM}.new"}},
				{"move": {"from": ".${PROGRAM}.new", "to": "${PROGRAM}"}},
				{"mkdir": ["logs"]}
			]
		},
		"run": {
			"description": "Build and start Crimson Text",
			"depends": "build",
			"steps": [
				"./${PROGRAM}"
			]
		},
		"install": {
			"description": "Install Crimson Text for the current user",
			"depends": "build",
			"steps": [
				"sh subprojects/crimson-core/scripts/install.sh"
			]
		},
		"install-default": {
			"description": "Install Crimson Text and make it the default for text files",
			"depends": "install",
			"steps": [
				"sh scripts/make-default.sh"
			]
		},
		"uninstall": {
			"description": "Remove Crimson Text from the current user",
			"steps": [
				"sh subprojects/crimson-core/scripts/uninstall.sh"
			]
		},
		"archive": {
			"description": "Pack Crimson Text into a tar.gz archive in dist",
			"depends": "build",
			"steps": [
				"sh subprojects/crimson-core/scripts/package.sh"
			]
		},
		"appimage": {
			"description": "Pack Crimson Text into an AppImage in dist",
			"depends": "build",
			"steps": [
				{"needs": ["quick-sharun"]},
				"sh subprojects/crimson-core/scripts/appimage.sh"
			]
		},
		"clean": {
			"description": "Remove the build folder",
			"steps": [
				{"remove": "build"}
			]
		}
	}
}
